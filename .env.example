# Copy to .env and fill in. .env is never committed.
# Gmail + Calendar sign-in (a Google Cloud OAuth "Desktop" client; redirect http://127.0.0.1:8765/api/outreach/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who AION sends as: comma-separated, the first is the default sender
AION_SENDERS=you@example.com,second@example.com
AION_NAME=Your Name
# Contact shown in the research user agent (some public data sources ask for one)
AION_CONTACT=you@example.com
# Optional paid email lookups (AION reads the firm's own website first, free)
# APOLLO_API_KEY=
# PDL_API_KEY=
